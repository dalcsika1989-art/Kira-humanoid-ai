# Server-only values. Copying to .env is optional; scripts/serve-secure.py can
# prompt for GEMINI_API_KEY without writing it to disk. Never use VITE_ for keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional professional animated avatar; paid/custom avatar provisioning required.
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# Exact additional frontend origins only. Leave empty for same-origin hosting.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=20
PORT=8787
HOST=127.0.0.1
# Enable only behind a trusted reverse proxy that removes spoofed identity headers.
TRUST_PROXY=0
